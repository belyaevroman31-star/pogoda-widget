<script>
(async function () {
  const out = document.getElementById("out");
  const j = await fetch("https://api.open-meteo.com/v1/forecast?latitude=55.75&longitude=37.62&timezone=auto&forecast_days=2&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,rain,showers,snowfall,weather_code,cloud_cover,pressure_msl,wind_speed_10m,wind_direction_10m,wind_gusts_10m,visibility&hourly=temperature_2m,apparent_temperature,relative_humidity_2m,precipitation_probability,precipitation,rain,showers,snowfall,weather_code,visibility,pressure_msl,wind_speed_10m,cloud_cover").then(r => r.json());
  // compact dump: stats to keep output small
  out.textContent = JSON.stringify({
    lat: j.latitude, lon: j.longitude, tz: j.timezone, off: j.utc_offset_seconds,
    cur: j.current && { t: j.current.temperature_2m, code: j.current.weather_code, rain: j.current.rain, snow: j.current.snowfall, vis: j.current.visibility },
    times0: (j.hourly && j.hourly.time || []).slice(0, 3),
    codes0_6: j.hourly && j.hourly.weather_code.slice(0, 6),
    rain0_6: j.hourly && j.hourly.rain.slice(0, 6),
    sf0_6: j.hourly && j.hourly.snowfall ? j.hourly.snowfall.slice(0, 6) : "NO_KEY",
    visMax: j.hourly && Math.max.apply(null, j.hourly.visibility.map(v => v == null ? 0 : v)),
    visMin: j.hourly && Math.min.apply(null, j.hourly.visibility.map(v => v == null ? 24000 : v)),
    probMax: j.hourly && Math.max.apply(null, j.hourly.precipitation_probability.map(v => v == null ? 0 : v)),
    hourlyLen: (j.hourly && j.hourly.time || []).length
  }, null, 2);
}
